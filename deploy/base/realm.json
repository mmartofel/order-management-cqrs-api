{
  "realm": "orders",
  "enabled": true,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "en",
    "pl"
  ],
  "defaultLocale": "en",
  "roles": {
    "realm": [
      {
        "name": "orders-viewer",
        "description": "Read orders, payments, deliveries and reference data"
      },
      {
        "name": "orders-editor",
        "description": "Read, and run commands on orders, payments and deliveries; edit reference data"
      }
    ]
  },
  "clients": [
    {
      "clientId": "orders-api",
      "enabled": true,
      "publicClient": false,
      "secret": "${ORDERS_API_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "orders-ui",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "/*",
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "/*##http://localhost:5173/*"
      },
      "rootUrl": "${authBaseUrl}"
    }
  ],
  "users": [
    {
      "username": "service-account-orders-api",
      "enabled": true,
      "serviceAccountClientId": "orders-api",
      "realmRoles": [
        "orders-editor"
      ]
    },
    {
      "username": "viewer",
      "enabled": true,
      "email": "viewer@example.com",
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "Viewer",
      "credentials": [
        {
          "type": "password",
          "value": "${DEMO_VIEWER_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "orders-viewer"
      ]
    },
    {
      "username": "editor",
      "enabled": true,
      "email": "editor@example.com",
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "Editor",
      "credentials": [
        {
          "type": "password",
          "value": "${DEMO_EDITOR_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "orders-editor"
      ]
    }
  ]
}
